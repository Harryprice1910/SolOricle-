############################
# Visual Studio
############################
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

############################
# Build output
############################
bin/
obj/
*/bin/
*/obj/

############################
# .NET / NuGet
############################
*.dll
*.exe
*.pdb
*.cache
project.assets.json
project.nuget.cache
.nuget/

############################
# MAUI / Xamarin / Android
############################
**/obj/Debug/
**/obj/Release/
**/*.dex
**/*.class
**/*.apk
**/*.aab
**/res.zip
**/classes.zip
**/packaged_resources
# NOTE: don't add "android/" or "AndroidManifest.xml" here - Windows ignores letter case,
# so they'd also hide the real Platforms/Android source code. obj/ already covers the build copies.

############################
# Local databases (may contain personal journal data)
############################
*.db
*.db-shm
*.db-wal

############################
# Logs
############################
*.log

